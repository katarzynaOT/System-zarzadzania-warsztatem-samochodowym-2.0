@page
@model WorkshopManager.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Logowanie";
}

<h1>@ViewData["Title"]</h1>

<form method="post">
    @Html.AntiForgeryToken()
    <div class="form-group">
        <label for="Input_Email">Adres e-mail</label>
        <input asp-for="Input.Email" class="form-control" />
        <span asp-validation-for="Input.Email" class="text-danger" />
    </div>

    <div class="form-group">
        <label for="Input_Password">Hasło</label>
        <input asp-for="Input.Password" class="form-control" type="password" />
        <span asp-validation-for="Input.Password" class="text-danger" />
    </div>

    <div class="form-group form-check">
        <input id="Input_RememberMe" name="Input.RememberMe" class="form-check-input" type="checkbox" />
        <label for="Input_RememberMe" class="form-check-label">Zapamiętaj mnie</label>
    </div>

    <button type="submit" class="btn btn-primary">Zaloguj</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

