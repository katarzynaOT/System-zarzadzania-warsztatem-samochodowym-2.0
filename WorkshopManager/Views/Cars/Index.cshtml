@model IEnumerable<WorkshopManager.Models.Car>
<table class="table">
    <tr>
        <th>Zdjęcie</th>
        <th>Nazwa</th>
        <th>Opis</th>
        <th></th>
    </tr>
    @foreach (var car in Model)
    {
        <tr>
            <td>
                @if (!string.IsNullOrEmpty(car.imageUrl))
                {
                    <img src="@car.imageUrl" style="max-width:70px; max-height:60px;" />
                }
            </td>
            <td>@car.Name</td>
            <td>@car.Description</td>
            <td>
                <a asp-action="Details" asp-route-id="@car.Id">Szczegóły</a>
            </td>
        </tr>
    }
</table>


