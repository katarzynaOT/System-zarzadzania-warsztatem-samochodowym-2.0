<!--at+model IEnumerable<WorkshopManager.Models.Customer>-->
@namespace WorkshopManager.Pages
@model WorkshopManager.Models.CustomerIndexData

@{
    ViewData["Title"] = "Customers";
    int customerId = -1 ;
}

<center><img src="~/images/reports.jpg" width="1200" /></center>
<h1>Customer Order Reports</h1>
<p>Click on report next to customer or select customer to access their car reports.</p>

<table class="table">
    <thead>
        <tr>
            <th>
                Customer Name
            </th>
            <th>
                Customer Lastname            </th>
            <th>
                Customer Email
            </th>
            <th>
                Customer Phone Number
            </th>
            <th>
                Customer Address
            </th>
            <th>
                Cars
            </th>
            <th>
                Actions
            </th>
        </tr>
    </thead>
    <tbody>
        
@foreach (var item in Model.Customers) {
            string selectedRow = "";
            if (item.Id == (int?)ViewData["CustomerID"])
            {
                selectedRow = "table-success";
                customerId = item.Id;
            }
        <tr class="@selectedRow">
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LastName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Phone)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Address)
            </td>
            <td>
                @foreach (var car in item.Cars)
                {
                    @car.Name @Html.Raw("-") @car.RegistrationPlate <br/>
                }
            </td>
            <td>
                <a asp-action="Report" asp-route-id="@item.Id">Car Reports</a> | 
                <a asp-action="Report" asp-route-customerid="@item.Id">Customer Report</a>
            </td>
        </tr>
}
    </tbody>
</table>

@if (Model.Cars != null)
{
    <h3>Cars owned by a customer</h3>
    <table class="table">
        <tr>
            
            <th>Name</th>
            <th>Brand</th>
            <th>Model</th>
            <th>Registration Plate</th>
            <th>Actions</th>
        </tr>

        @foreach (var item in Model.Cars)
        {
            string selectedRow = "";
            if (item.Id == (int?)ViewData["CarID"])
            {
                selectedRow = "table-success";
            }
            <tr class="@selectedRow">
                <td>
                    @item.Name
                </td>
                <td>
                    @item.Brand
                </td>
                <td>
                    @item.Model
                </td>
                <td>
                    @item.RegistrationPlate
                </td>
                <td>
                    <a asp-action="Report" asp-route-carId="@item.Id">Car Report</a>
                </td>

            </tr>
        }

    </table>
}

@if (Model.selectedCustomer !=null && Model.selectedCar ==null)
{
    <h2>All Orders for Customer: @Model.selectedCustomer.Name @Model.selectedCustomer.LastName</h2>
}

@if (Model.selectedCustomer !=null && Model.selectedCar !=null)
{
    <h2>All Orders for Customer's: @Model.selectedCustomer.Name @Model.selectedCustomer.LastName car: @Model.selectedCar.Name</h2>
}

@if (Model.SelectedCarOrders != null)
{
    <table class="table">
        <tr>
            <th>Car Id</th>
            <th>Car Name</th>
            <th>Service Description</th>
            <th>Order Status</th>
            <th>Completed Date</th>
            <th>Assigned Mechanic</th>
            <th>Final Price</th>
        </tr>

        @foreach (var item in Model.SelectedCarOrders)
        {
            <tr>
                <td>
                    @item.CarId
                </td>
                <td>
                    @item.Car.Name
                </td>
                <td>
                    @item.Description
                </td>
                <td>
                    @item.Status
                </td>
                <td>
                    @item.CompletedDate
                </td>
                <td>
                    @item.AssignedMechanic
                </td>
                <td>
                    @item.Price
                </td>

            </tr>
        }

    </table>
}

