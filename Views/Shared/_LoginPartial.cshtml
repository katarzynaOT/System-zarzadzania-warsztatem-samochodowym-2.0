@using Microsoft.AspNetCore.Identity
@using WorkshopManager.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
                Hello @User.Identity?.Name!
            </a>
        </li>

        <!-- Sprawdzanie roli użytkownika -->
        @if (User.IsInRole("Admin"))
        {
            <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Panel" asp-action="ManageUsers">
                    Zarządzanie użytkownikami
                </a>
            </li>
        }

        @if (User.IsInRole("Mechanik"))
        {
            <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Panel" asp-action="MechanicDashboard">
                    Panel Mechanika
                </a>
            </li>
        }

        @if (User.IsInRole("Recepcjonista"))
        {
            <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Panel" asp-action="ReceptionDashboard">
                    Panel Recepcjonisty
                </a>
            </li>
        }

        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" method="post">
                <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
            </form>
        </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
}
</ul>

@if (User.Identity?.IsAuthenticated ?? false)
{
    <a asp-controller="Panel" asp-action="Index">Panel</a>
    <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline">
        <button type="submit" class="btn btn-link">Wyloguj</button>
    </form>
}
else
{
    <a asp-area="Identity" asp-page="/Account/Login">Zaloguj</a> 
    <a asp-area="Identity" asp-page="/Account/Register">Zarejestruj</a>
}
