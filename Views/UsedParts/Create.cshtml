@model WorkshopManager.Models.UsedPart

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>UsedPart</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="PartId" class="control-label"></label>
                <select asp-for="PartId" class ="form-control" asp-items="ViewBag.PartId" id="partid" onchange="UpdateRouteQuantity()"></select>
            </div>
            <div class="form-group">
                <label asp-for="ServiceTaskId" class="control-label"></label>
                <select asp-for="ServiceTaskId" class ="form-control" asp-items="ViewBag.ServiceTaskId"></select>
            </div>
            <div class="form-group">
                <label asp-for="Quantity" class="control-label"></label>
                <input asp-for="Quantity" class="form-control" id="quantityval" onchange="UpdateRouteQuantity()" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TotalCost" class="control-label"></label>
                <input asp-for="TotalCost" class="form-control" value="@ViewData["NewCost"]"/>
                <span asp-validation-for="TotalCost" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Create" asp-route-recalc="1" asp-route-quantity="0" asp-route-partid="0" id="recalcroute">Recalculate Total Cost</a> |
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<script type="text/javascript">
    function UpdateRouteQuantity() {

        //$('#recalcroute').attr("asp-route-quantity",$('#quantityval').val());
        $('#recalcroute').attr("href","/UsedParts/Create?recalc=1&quantity="+$('#quantityval').val()+"&partid="+$('#partid').val());
        console.log("New quantity val:"+$('#quantityval').val());
        console.log("updated asp action routing"+$('#recalcroute'));

    }
</script>