@model WorkshopManager.Models.UsedPart

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>UsedPart</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Part)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Part.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ServiceTask)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ServiceTask.Id)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Quantity)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Quantity)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TotalCost)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TotalCost)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a> | 
    <a asp-controller="ServiceTasks" asp-action="Details" asp-route-id="@Model?.ServiceTaskId">Go to Service Task</a>
</div>
