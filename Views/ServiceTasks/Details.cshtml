<!--at+model WorkshopManager.Models.ServiceTask -->
@model WorkshopManager.Models.TaskIndexData

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>ServiceTask</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Task.Id)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Task.Id)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Task.Description)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Task.Description)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Task.Title)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Task.Title)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Task.LaborCost)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Task.LaborCost)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Task.Id">Edit</a> |
    <a asp-action="Index">Back to All Tasks List</a> |
    <a asp-controller="ServiceOrders" asp-action="Details" asp-route-id="@Model?.Task.Order.Id">Back to Service Order</a>
</div>

<h3>Parts Used for the Service Task</h3>
<a asp-controller="UsedParts" asp-action="Create" asp-route-servicetask_id="@Model?.Task.Id">Use Additional Part</a>

@if (Model.TaskParts != null)
{
    <table class="table">
        <tr>

            <th>Part Name</th>
            <th>Quantity</th>
            <th>Cost</th>
            <th>Actions</th>
        </tr>

        @foreach (var item in Model.TaskParts)
        {
            <tr>
                <td>
                    @item.Part.Name
                </td>
                <td>
                    @item.Quantity
                </td>
                <td>
                    @item.TotalCost
                </td>
                <td>
                    <a asp-controller="UsedParts" asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-controller="UsedParts" asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-controller="UsedParts" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>

            </tr>
        }

    </table>
}

