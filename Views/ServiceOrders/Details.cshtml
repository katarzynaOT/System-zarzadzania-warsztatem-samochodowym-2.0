<!-- at+model WorkshopManager.Models.ServiceOrder -->
@model WorkshopManager.Models.OrderIndexData
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager


@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>


<div>
    <h4>ServiceOrder</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Order.Id)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Order.Id)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Order.Car.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Order.Car.Name)
            <a asp-controller="Cars" asp-action="Details" asp-route-id="@Model.Order.CarId">Car Details</a>
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Order.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Order.Description)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Order.Status)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Order.Status)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Order.CompletedDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Order.CompletedDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Order.AssignedMechanic)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Order.AssignedMechanic)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Order.Price)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Order.Price)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Order.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>

<h3>Comments for the Service Order</h3>

@if (SignInManager.IsSignedIn(User))
{
    <p>
        <a asp-controller="Comments" asp-action="Create" asp-route-serviceorder_id="@Model?.Order.Id">Add New Comment</a>
    </p>
}


@if (Model.Comments!= null)
{
    <table class="table">
        <tr>

            <th>Created Date</th>
            <th>Content</th>
            <th>Author</th>
            <th>AuthorId</th>
            <th>Actions</th>
        </tr>

        @foreach (var item in Model.Comments)
        {
            <tr>
                <td>
                    @item.CreatedDate
                </td>
                <td>
                    @item.Content
                </td>
                <td>
                    @item.Author
                </td>
                <td>
                    @item.AuthorId
                </td>
                <td>
                    <a asp-controller="Comments" asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-controller="Comments" asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-controller="Comments" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>

            </tr>
        }

    </table>
}

<h3>Service Tasks for the Service Order</h3>
<a asp-controller="ServiceTasks" asp-action="Create" asp-route-serviceorder_id="@Model?.Order.Id">Add New Task</a>

@if (Model.ServiceTasks != null)
{
    <table class="table">
        <tr>

            <th>Task Id</th>
            <th>Title</th>
            <th>Description</th>
            <th>Labour Costs</th>
            <th>Used Parts</th>
            <th>Actions</th>
        </tr>

        @foreach (var item in Model.ServiceTasks)
        {
            <tr>
                <td>
                    @item.Id
                </td>
                <td>
                    @item.Title
                </td>
                <td>
                    @item.Description
                </td>
                <td>
                    @item.LaborCost
                </td>
                <td>
                    @if (item.UsedParts!=null) {
                        @foreach (var part in item.UsedParts)
                        {
                            @part.Quantity @Html.Raw("x of ") @part.PartId @Html.Raw(" (total cost:") @part.TotalCost @Html.Raw("PLN)")<br />
                        }
                    }
                    else
                    {
                        <p>No parts used</p>
                    }
                </td>
                <td>
                    <a asp-controller="ServiceTasks" asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-controller="ServiceTasks" asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-controller="ServiceTasks" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>

            </tr>
        }

    </table>
}

