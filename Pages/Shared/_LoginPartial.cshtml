@using Microsoft.AspNetCore.Identity
@using WorkshopManager.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
                Hello @User.Identity?.Name!
            </a>
        </li>

        <!-- Sprawdzanie roli użytkownika -->
        @if (User.IsInRole("Admin"))
        {
            <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Panel" asp-action="ManageUsers">
                    Manage Users
                </a>
                </li>
           <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Panel" asp-action="">
                    Panel
                </a>

            </li>
        }

        @if (User.IsInRole("Mechanik"))
        {
            <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Panel" asp-action="MechanicDashboard">
                    User Panel
                </a>
            </li>
        }

        @if (User.IsInRole("Recepcjonista"))
        {
            <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Panel" asp-action="">
                    User Panel
                </a>
            </li>
        }

        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" method="post">
                <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
            </form>
        </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
}
</ul>
