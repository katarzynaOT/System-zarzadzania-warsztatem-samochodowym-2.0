@page
@model WorkshopManager.Pages.PanelModel
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
<h2>Twoj panel</h2>
<p>Witaj, @User.Identity.Name!</p>

@if (User.Identity.IsAuthenticated && User.IsInRole("Recepcjonista"))
{
    <a class="nav-link text-dark" asp-area="" asp-controller="Customers" asp-action="Report">Customer Order Reports</a>
}

@if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
{
    <a class="nav-link text-dark" asp-area="" asp-controller="ServiceOrders" asp-action="Archive">Service Order Reports</a>
}

